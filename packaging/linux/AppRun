#!/bin/sh
# AppImage entry point. The package keeps the ONNX runtime under usr/lib/sonicator; the binary's
# rpath already names that directory, and this export keeps a copied AppDir working even if a
# future runtime gains a dependency of its own.
HERE=$(dirname "$(readlink -f "$0")")
export LD_LIBRARY_PATH="$HERE/usr/lib/sonicator${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
exec "$HERE/usr/bin/SONICATOR" "$@"
