<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
  <title>SONICATOR @VERSION@</title>
  <readme file="README.txt" mime-type="text/plain"/>
  <options customize="always" require-scripts="true" rootVolumeOnly="true" hostArchitectures="arm64,x86_64"/>
  <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
  <allowed-os-versions><os-version min="11.0"/></allowed-os-versions>
  <choices-outline>
    <line choice="app"/>
    <line choice="vst3"/>
    <line choice="au"/>
  </choices-outline>
  <choice id="app" title="SONICATOR application" start_selected="true" description="Standalone library browser in Applications.">
    <pkg-ref id="com.sonicator.installer.app"/>
  </choice>
  <choice id="vst3" title="VST3 plugin" start_selected="true" description="SONICATOR for VST3-compatible DAWs.">
    <pkg-ref id="com.sonicator.installer.vst3"/>
  </choice>
  <choice id="au" title="Audio Unit plugin" start_selected="true" description="SONICATOR for Logic and other Audio Unit hosts.">
    <pkg-ref id="com.sonicator.installer.au"/>
  </choice>
  <pkg-ref id="com.sonicator.installer.app" version="@VERSION@" onConclusion="none">app.pkg</pkg-ref>
  <pkg-ref id="com.sonicator.installer.vst3" version="@VERSION@" onConclusion="none">vst3.pkg</pkg-ref>
  <pkg-ref id="com.sonicator.installer.au" version="@VERSION@" onConclusion="none">au.pkg</pkg-ref>
</installer-gui-script>
