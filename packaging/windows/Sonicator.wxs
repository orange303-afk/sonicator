<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="SONICATOR" Manufacturer="Ilya Orange" Version="$(var.Version)"
           UpgradeCode="CDE66114-09E7-41D4-B8E5-9E4126C21354" Scope="perMachine"
           InstallerVersion="500" Compressed="yes" Language="1033">
    <SummaryInformation Description="SONICATOR application and VST3 plugin (unsigned)"/>
    <MajorUpgrade DowngradeErrorMessage="A newer version of SONICATOR is already installed."
                  AllowSameVersionUpgrades="yes" Schedule="afterInstallInitialize"/>
    <MediaTemplate EmbedCab="yes"/>
    <!-- MSI deliberately reports VersionNT=603 / WindowsBuild=9600 on newer Windows.
         Query the real build, rather than rejecting supported Windows 10/11/Server. -->
    <Property Id="WINDOWSBUILDNUMBER" Secure="yes">
      <RegistrySearch Id="CurrentWindowsBuild" Root="HKLM"
                      Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion"
                      Name="CurrentBuildNumber" Type="raw" Bitness="always64"/>
    </Property>
    <Launch Condition="Installed OR (VersionNT64 AND WINDOWSBUILDNUMBER &gt;= 10240)"
            Message="SONICATOR requires 64-bit Windows 10 or later."/>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="SONICATOR"/>
    </StandardDirectory>
    <StandardDirectory Id="CommonFiles64Folder">
      <Directory Id="VST3ROOT" Name="VST3">
        <Directory Id="VST3BUNDLE" Name="SONICATOR.vst3"/>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder"/>
    <Feature Id="AppFeature" Title="SONICATOR application" Description="Standalone library browser."
             Level="1" AllowAdvertise="no" ConfigurableDirectory="INSTALLFOLDER">
      <ComponentGroupRef Id="AppPayload"/>
    </Feature>
    <Feature Id="Vst3Feature" Title="VST3 plugin" Description="SONICATOR for VST3-compatible DAWs."
             Level="1" AllowAdvertise="no">
      <ComponentGroupRef Id="Vst3Payload"/>
    </Feature>
    <ui:WixUI Id="WixUI_FeatureTree"/>
    <UIRef Id="WixUI_ErrorProgressText"/>
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)"/>
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT" Value="Run the application first to create or update your library. Restart/rescan your DAW to find the VST3 plugin. This installer is unsigned."/>
  </Package>
</Wix>
